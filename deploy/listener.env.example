# x100-listener settings (on the Raspberry Pi). Only BRIDGE_URL and BRIDGE_TOKEN are required,
# and deploy/install.sh fills both in when the bridge runs on this Pi too.

# --- the bridge --------------------------------------------------------------------
# http://127.0.0.1:8661 when the bridge runs on this Pi; otherwise that machine's LAN address
# and the port in its LOCAL_API_BIND
BRIDGE_URL=http://192.168.1.50:8661
# The same value as LOCAL_API_TOKEN in the bridge's bridge.env
BRIDGE_TOKEN=
# Seconds to wait for the bridge's answer (an "on" takes about 3, as the bridge waits
# to see the projector start)
# BRIDGE_TIMEOUT=10

# --- models (x100-listener --download-models puts them here) ----------------------
MODELS_DIR=models

# --- microphone --------------------------------------------------------------------
# A number or part of the name from `x100-listener --list-devices`; empty = system default
MIC_DEVICE=Jabra
# 0 for the Jabra Speak 510. 1 for the ReSpeaker XVF3800 (its speech-recognition beam).
MIC_CHANNEL=0
# Only if the mic won't capture at 16 kHz on its own:
# MIC_RATE=48000

# --- wake word ("Hey Jarvis") ------------------------------------------------------
# 0..1, higher = fewer false wakes but more misses. Tune with --test-mic: your
# "Hey Jarvis" should score well above it, the film well below. 0.3 if it misses
# you; 0.5 or more if it wakes during films (you'd hear the low note).
WAKE_THRESHOLD=0.4
# Ask a voice-activity detector to agree too (0 = off; try 0.5 if films wake it)
# VAD_THRESHOLD=0
# Speex noise suppression for steady noise (fans): needs `pip install speexdsp-ns`
# SPEEX_NS=false
# How many cores the wake word may use. Default: 2 on a machine with 4 or more cores (the
# fastest on a Pi 3, where 4 was much slower), otherwise 1. Compare settings with
# `--wav <clip> --seconds 20`, which ends with a speed report.
# WAKE_THREADS=2

# --- the command after the wake word ---------------------------------------------
# 0..1, lower = easier to trigger. Raise it if commands fire on their own.
KWS_THRESHOLD=0.25
# How strongly the spotter favours the command phrases (2.5 if commands are missed)
# KWS_BOOST=2.0
# Search width, and how many blank steps (~40 ms each) must follow a phrase
# KWS_PATHS=6
# KWS_TRAILING_BLANKS=2
# How many cores the command spotter may use; the same default as WAKE_THREADS
# KWS_THREADS=2
# Amplify the command to match how loudly "Hey Jarvis" was said (helps quiet speech)
# COMMAND_GAIN=true
# Seconds to wait for the command after "Hey Jarvis"
COMMAND_WINDOW=3.5
# COOLDOWN=2
# More phrases, numbers written as words. Ops are the bridge's (power, input, volume,
# volume_delta, mute, key):
# EXTRA_PHRASES={"projector HDMI two": [{"op": "input", "value": "HDMI 2"}], "projector mute": [{"op": "mute", "value": true}]}

# --- chimes ------------------------------------------------------------------------
CHIMES=true
# Default: the mic's own speaker (right for the Jabra). Otherwise a number or name
# from --list-devices, e.g. the XVF3800's 3.5 mm jack or the Pi's headphone jack.
# CHIME_DEVICE=
CHIME_VOLUME=0.3
# A blip as soon as "Hey Jarvis" is heard (off: it talks over a one-breath command)
# WAKE_CHIME=false
# The low note when "Hey Jarvis" isn't followed by a command (turn off if films set it off)
# UNCLEAR_CHIME=true

# --- diagnostics -------------------------------------------------------------------
# Keep a WAV of every trigger here, to see what set it off (the newest 500 are kept)
# SAVE_CLIPS_DIR=clips
LOG_LEVEL=INFO
